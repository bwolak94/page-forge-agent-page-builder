{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Task Success Rate (Evals)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(pageforge_task_success_total) / (sum(pageforge_task_success_total) + 1)",
          "legendFormat": "Pass Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p50 Tool Calls per Task",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(pageforge_tool_calls_per_task_bucket[5m]))",
          "legendFormat": "p50 tool calls",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(pageforge_tool_calls_per_task_bucket[5m]))",
          "legendFormat": "p95 tool calls",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool Error Rate (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum by (tool, error_kind) (rate(pageforge_tool_errors_total[5m]))",
          "legendFormat": "{{tool}}/{{error_kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 Cost per Session (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineWidth": 2 },
          "decimals": 4
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pageforge_cost_per_session_usd_bucket[10m]))",
          "legendFormat": "p95 cost/session",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(pageforge_cost_per_session_usd_bucket[10m]))",
          "legendFormat": "p50 cost/session",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 First-Patch Latency (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pageforge_first_patch_latency_ms_bucket[5m]))",
          "legendFormat": "p95 first-patch latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Manual Corrections per Hour",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "rate(pageforge_manual_correction_total[1h])",
          "legendFormat": "Manual corrections/hr",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["pageforge", "agent", "quality"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PageForge Agent Quality",
  "uid": "pageforge-agent-quality",
  "version": 1
}
