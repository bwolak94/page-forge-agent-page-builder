# PageForge — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pageforge:pageforge@localhost:5432/pageforge

# ── Redis (BullMQ queue) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Observability — Langfuse ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Observability — OpenTelemetry ─────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pageforge-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Cloudflare R2 (export artifact storage) ───────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pageforge-exports

# ── Agent HTTP server ─────────────────────────────────────────────────────────
PORT=3001

# ── HTML export worker ────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2

# ── E2e tests only ───────────────────────────────────────────────────────────
# ID of a seeded document in the test DB (used by Playwright visual regression)
FIXTURE_DOC_ID=

# Playwright base URL (defaults to http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000
