# Hoist ESLint and Playwright binaries so workspace packages can call them
# without adding eslint as a devDependency to every package.json.
public-hoist-pattern[]=eslint
public-hoist-pattern[]=eslint-plugin-*
public-hoist-pattern[]=@eslint/*
public-hoist-pattern[]=typescript-eslint
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=@playwright/test
