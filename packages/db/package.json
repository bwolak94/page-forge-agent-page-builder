{
  "name": "@pageforge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src/ --max-warnings 0",
    "test": "SKIP_INTEGRATION=1 vitest run --passWithNoTests",
    "test:integration": "vitest run --reporter=verbose src/__tests__/persistence.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@pageforge/ir": "workspace:*",
    "@pageforge/commands": "workspace:*",
    "@pageforge/registry": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.22.0",
    "drizzle-kit": "^0.30.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
